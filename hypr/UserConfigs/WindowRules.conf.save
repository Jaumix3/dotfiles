# /* ---- 💫 https://github.com/JaKooLit 💫 ---- */  #
# For window rules and layerrules
# Updated for Hyprland >= 0.48 (windowrulev2 / layerrulev2)

####################
# TAGS
####################

# browser tags
windowrulev2 = tag +browser, class:^([Ff]irefox|org.mozilla.firefox|[Ff]irefox-esr|[Ff]irefox-bin)$
windowrulev2 = tag +browser, class:^([Gg]oogle-chrome(-beta|-dev|-unstable)?)$
windowrulev2 = tag +browser, class:^(chrome-.+-Default)$
windowrulev2 = tag +browser, class:^([Cc]hromium)$
windowrulev2 = tag +browser, class:^([Mm]icrosoft-edge(-stable|-beta|-dev|-unstable))$
windowrulev2 = tag +browser, class:^(Brave-browser(-beta|-dev|-unstable)?)$
windowrulev2 = tag +browser, class:^([Tt]horium-browser|[Cc]achy-browser)$
windowrulev2 = tag +browser, class:^(zen-alpha|zen)$

# notif tags
windowrulev2 = tag +notif, class:^(swaync-control-center|swaync-notification-window|swaync-client)$

# KooL tags
windowrulev2 = tag +KooL_Cheat, title:^(KooL Quick Cheat Sheet)$
windowrulev2 = tag +KooL_Settings, title:^(KooL Hyprland Settings)$
windowrulev2 = tag +KooL-Settings, class:^(nwg-displays|nwg-look)$

# terminal tags
windowrulev2 = tag +terminal, class:^(Alacritty|kitty|kitty-dropterm)$

# email tags
windowrulev2 = tag +email, class:^([Tt]hunderbird|org.gnome.Evolution|eu.betterbird.Betterbird)$

# project tags
windowrulev2 = tag +projects, class:^(codium|codium-url-handler|VSCodium|VSCode|code-url-handler|jetbrains-.+)$

# screenshare tags
windowrulev2 = tag +screenshare, class:^(com.obsproject.Studio)$

# IM tags
windowrulev2 = tag +im, class:^([Dd]iscord|[Ww]ebCord|[Vv]esktop|[Ff]erdium|[Ww]hatsapp-for-linux|ZapZap|com.rtosta.zapzap|org.telegram.desktop|io.github.tdesktop_x64.TDesktop|teams-for-linux|im.riot.Riot|Element)$n
# game tags
windowrulev2 = tag +games, class:^(gamescope|steam_app_\d+)$

# gamestore tags
windowrulev2 = tag +gamestore, class:^([Ss]team|com.heroicgameslauncher.hgl)$
windowrulev2 = tag +gamestore, title:^([Ll]utris)$

# file-manager tags
windowrulev2 = tag +file-manager, class:^([Tt]hunar|org.gnome.Nautilus|[Pp]cmanfm-qt|app.drey.Warp)$

# wallpaper tags
windowrulev2 = tag +wallpaper, class:^([Ww]aytrogen)$

# multimedia tags
windowrulev2 = tag +multimedia, class:^([Aa]udacious)$
windowrulev2 = tag +multimedia_video, class:^([Mm]pv|vlc)$

# settings tags
windowrulev2 = tag +settings, title:^(ROG Control|Kvantum Manager)$
windowrulev2 = tag +settings, class:^(wihotspot(-gui)?|gnome-disks|file-roller|org.gnome.FileRoller|nm-applet|nm-connection-editor|blueman-manager|pavucontrol|org.pulseaudio.pavucontrol|com.saivert.pwvucontrol|qt5ct|qt6ct|[Yy]ad|xdg-desktop-portal-gtk|org.kde.polkit-kde-authentication-agent-1|[Rr]ofi)$
windowrulev2 = tag +settings, class:^([Bb]aobab|org.gnome.[Bb]aobab)$

# viewer tags
windowrulev2 = tag +viewer, class:^(gnome-system-monitor|org.gnome.SystemMonitor|io.missioncenter.MissionCenter|evince|eog|org.gnome.Loupe)$

####################
# POSITION
####################

windowrulev2 = center, tag:KooL_Cheat*
windowrulev2 = center, class:^([Tt]hunar)$, title:negative:(.*[Tt]hunar.*)
windowrulev2 = center, title:^(ROG Control|Keybindings)$
windowrulev2 = center, tag:KooL-Settings*
windowrulev2 = center, class:^(pavucontrol|org.pulseaudio.pavucontrol|com.saivert.pwvucontrol|[Ww]hatsapp-for-linux|ZapZap|com.rtosta.zapzap|[Ff]erdium)$
windowrulev2 = move 72% 7%, title:^(Picture-in-Picture)$

####################
# IDLE INHIBIT
####################

windowrulev2 = idleinhibit fullscreen, fullscreen:1

####################
# WORKSPACES
####################

windowrulev2 = workspace 1, tag:email*
windowrulev2 = workspace 2, tag:browser*
windowrulev2 = workspace 5, tag:gamestore*
windowrulev2 = workspace 7, tag:im*
windowrulev2 = workspace 8, tag:games*

windowrulev2 = workspace 4 silent, tag:screenshare*
windowrulev2 = workspace 6 silent, class:^(virt-manager|.virt-manager-wrapped)$
windowrulev2 = workspace 9 silent, tag:multimedia*

####################
# FLOAT
####################

windowrulev2 = float, tag:(KooL_Cheat*|wallpaper*|settings*|viewer*|KooL-Settings*)
windowrulev2 = float, class:([Zz]oom|onedriver|onedriver-launcher)$
windowrulev2 = float, class:org.gnome.Calculator, title:(Calculator)
windowrulev2 = float, class:^(mpv|com.github.rafostar.Clapper|[Qq]alculate-gtk|[Ff]erdium)$
windowrulev2 = float, title:^(Picture-in-Picture)$

####################
# DIALOGS
####################

windowrulev2 = float, title:^(Authentication Required)$
windowrulev2 = center, title:^(Authentication Required)$
windowrulev2 = float, class:(codium|codium-url-handler|VSCodium)$, title:negative:(.*codium.*|.*VSCodium.*)
windowrulev2 = float, class:^([Ss]team)$, title:negative:^([Ss]team)$
windowrulev2 = float, class:^([Tt]hunar)$, title:negative:(.*[Tt]hunar.*)

windowrulev2 = float, title:^(Add Folder to Workspace|Save As|Open Files|SDDM Background)$
windowrulev2 = size 70% 60%, title:^(Add Folder to Workspace|Save As|Open Files)$
windowrulev2 = center, title:^(Add Folder to Workspace|Save As|SDDM Background)$
windowrulev2 = size 16% 12%, title:^(SDDM Background)$

####################
# SIZE
####################

windowrulev2 = size 65% 90%, tag:KooL_Cheat*
windowrulev2 = size 70% 70%, tag:(wallpaper*|settings*)
windowrulev2 = size 60% 70%, class:^([Ww]hatsapp-for-linux|ZapZap|com.rtosta.zapzap|[Ff]erdium)$

####################
# PINNING / EXTRAS
####################

windowrulev2 = pin, title:^(Picture-in-Picture)$
windowrulev2 = keepaspectratio, title:^(Picture-in-Picture)$

####################
# BLUR / FULLSCREEN
####################

windowrulev2 = noblur, tag:games*
windowrulev2 = fullscreen, tag:games*

####################
# FOCUS
####################

windowrulev2 = noinitialfocus, class:^(jetbrains-*)$
windowrulev2 = noinitialfocus, title:^(wind.*)$

####################
# LAYER RULES
####################

layerrulev2 = blur, namespace:rofi
layerrulev2 = ignorezero, namespace:rofi

layerrulev2 = blur, namespace:notifications
layerrulev2 = ignorezero, namespace:notifications

layerrulev2 = blur, namespace:quickshell:overview
layerrulev2 = ignorezero, namespace:quickshell:overview
layerrulev2 = ignorealpha 0.5, namespace:quickshell:overview
